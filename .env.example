# Supabase (product images / storage)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Backend API base URL for this deployment
API_BASE_URL=

# Per-business identity — required for every deployment, otherwise the site
# silently falls back to INDOORSHOPPING's defaults (wrong brand, wrong pixel).
# Facebook/WhatsApp links are NOT set here — they come from this business's
# own record via the API (Business.social.facebook / .whatsapp).
BUSINESS_ID=
NUXT_PUBLIC_PIXEL_ID=

# Production origin, used for canonical/hreflang URLs (no trailing slash)
NUXT_PUBLIC_SITE_URL=

# Public-facing brand name for this deployment. Drives the static <title>
# template, og:site_name, and footer fallback for first paint / no-JS / crawlers
# before the business record loads client-side. The branding plugin overrides
# these at runtime from the business API once loaded. Leave unset only if you
# accept generic titles until JS runs.
NUXT_PUBLIC_SITE_NAME=

# Optional Twitter/X handle (e.g. @yourbrand) for the twitter:site tag. Omitted
# from the page entirely when unset.
NUXT_PUBLIC_TWITTER_SITE=
