# Supabase (product images / storage)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Backend API base URL for this deployment
API_BASE_URL=

# Per-business identity — required for every deployment, otherwise the site
# silently falls back to INDOORSHOPPING's defaults (wrong brand, wrong pixel).
# Facebook/WhatsApp links are NOT set here — they come from this business's
# own record via the API (Business.social.facebook / .whatsapp).
BUSINESS_ID=
NUXT_PUBLIC_PIXEL_ID=

# Production origin, used for canonical/hreflang URLs (no trailing slash)
NUXT_PUBLIC_SITE_URL=
